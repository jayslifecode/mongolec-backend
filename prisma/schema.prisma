// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
  binaryTargets   = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================
// TENANT MANAGEMENT
// ================================

model Tenant {
  id        String       @id @default(cuid())
  slug      String       @unique
  name      String
  domain    String?      @unique
  status    TenantStatus @default(ACTIVE)
  plan      TenantPlan   @default(FREE)
  config    Json         @default("{}")
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  deletedAt DateTime?

  // Relations
  users           User[]
  roles           Role[]
  permissions     Permission[]
  content         Content[]
  media           Media[]
  auditLogs       AuditLog[]
  tags            Tag[]
  settings        Setting[]
  apiTokens       ApiToken[]
  webhooks        Webhook[]
  newsCategories  NewsCategory[]
  newsArticles    NewsArticle[]
  merchCategories MerchCategory[]
  merchProducts   MerchProduct[]

  // Rally for Rangers
  rallies           Rally[]
  applications      RallyApplication[]
  parkPartnerships  ParkPartnership[]
  stories           Story[]
  rallyMedia        RallyMedia[]
  newsletterSubs    NewsletterSubscription[]
  parkNominations   ParkNomination[]
  teamMembers       TeamMember[]
  contactMessages   ContactMessage[]
  rangers           Ranger[]
  participants      Participant[]

  @@map("tenants")
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
  PENDING
  ARCHIVED
}

enum TenantPlan {
  FREE
  BASIC
  PRO
  ENTERPRISE
}

// ================================
// USER MANAGEMENT & AUTHENTICATION
// ================================

model User {
  id            String    @id @default(cuid())
  email         String
  firstName     String
  lastName      String
  password      String
  isActive      Boolean   @default(false)  // Requires admin approval
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  // Admin approval tracking
  approvedAt       DateTime?
  approvedBy       String?   // User ID of admin who approved
  rejectedAt       DateTime?
  rejectedBy       String?   // User ID of admin who rejected
  rejectionReason  String?

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // User roles (many-to-many)
  roles UserRole[]

  // Content relations
  createdContent Content[] @relation("ContentCreator")
  updatedContent Content[] @relation("ContentUpdater")

  // Media relations
  uploadedMedia Media[]

  // Audit log relations
  auditLogs AuditLog[]

  // API token relations
  apiTokens ApiToken[]

  // News relations
  createdNewsArticles NewsArticle[] @relation("NewsArticleCreator")
  updatedNewsArticles NewsArticle[] @relation("NewsArticleUpdater")

  // Merch relations
  createdMerchProducts MerchProduct[] @relation("MerchProductCreator")
  updatedMerchProducts MerchProduct[] @relation("MerchProductUpdater")

  // Rally for Rangers relations
  createdRallies Rally[] @relation("RallyCreator")
  updatedRallies Rally[] @relation("RallyUpdater")
  createdStories Story[] @relation("StoryCreator")
  uploadedRallyMedia RallyMedia[] @relation("RallyMediaUploader")

  @@unique([email, tenantId])
  @@index([tenantId, isActive])
  @@index([tenantId, isActive, approvedAt])
  @@index([tenantId, rejectedAt])
  @@index([tenantId, createdAt])
  @@map("users")
}

// ================================
// ROLE-BASED ACCESS CONTROL (RBAC)
// ================================

model Role {
  id          String    @id @default(cuid())
  name        String
  description String?
  isSystem    Boolean   @default(false)
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Role permissions (many-to-many)
  permissions RolePermission[]

  // User roles (many-to-many)
  users UserRole[]

  @@unique([name, tenantId])
  @@map("roles")
}

model Permission {
  id          String    @id @default(cuid())
  name        String
  resource    String
  action      String
  conditions  Json      @default("{}")
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Role permissions (many-to-many)
  roles RolePermission[]

  @@unique([resource, action, tenantId])
  @@map("permissions")
}

// Junction tables for many-to-many relationships
model UserRole {
  id         String   @id @default(cuid())
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  assignedBy String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(cuid())
  roleId       String
  permissionId String
  assignedAt   DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

// ================================
// CONTENT MANAGEMENT SYSTEM
// ================================

model Content {
  id            String        @id @default(cuid())
  title         Json // {"en": "Title", "mn": "Гарчиг"}
  slug          String
  type          ContentType   @default(PAGE)
  status        ContentStatus @default(DRAFT)
  content       Json // {"en": "Content", "mn": "Агуулга"}
  excerpt       Json? // {"en": "Excerpt", "mn": "Товчлол"}
  featuredImage String?
  metadata      Json          @default("{}")
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  deletedAt     DateTime?

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Content authoring
  createdById String
  createdBy   User    @relation("ContentCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?   @relation("ContentUpdater", fields: [updatedById], references: [id])

  // Content relationships
  parentId String?
  parent   Content?  @relation("ContentHierarchy", fields: [parentId], references: [id])
  children Content[] @relation("ContentHierarchy")

  // Content media
  media ContentMedia[]

  // Content tags (many-to-many)
  tags ContentTag[]

  @@unique([slug, tenantId])
  @@map("content")
}

enum ContentType {
  PAGE
  POST
  ARTICLE
  PRODUCT
  CATEGORY
  CUSTOM
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
  SCHEDULED
}

// ================================
// MEDIA MANAGEMENT
// ================================

model Media {
  id           String    @id @default(cuid())
  filename     String
  originalName String
  path         String
  url          String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  alt          Json? // {"en": "Alt text", "mn": "Зургийн тайлбар"}
  description  Json? // {"en": "Description", "mn": "Тодорхойлолт"}
  metadata     Json      @default("{}")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Media uploader
  uploadedById String
  uploadedBy   User   @relation(fields: [uploadedById], references: [id])

  // Content associations
  content ContentMedia[]

  // News relations
  featuredInNewsArticles NewsArticle[] @relation("NewsFeaturedImage")

  @@map("media")
}

// Junction table for content-media relationships
model ContentMedia {
  id        String    @id @default(cuid())
  contentId String
  mediaId   String
  order     Int       @default(0)
  type      MediaType @default(ATTACHMENT)

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@unique([contentId, mediaId])
  @@map("content_media")
}

enum MediaType {
  FEATURED
  GALLERY
  ATTACHMENT
  INLINE
}

// ================================
// TAXONOMY SYSTEM
// ================================

model Tag {
  id          String    @id @default(cuid())
  name        Json // {"en": "Tag Name", "mn": "Шошгоны нэр"}
  slug        String
  description Json? // {"en": "Description", "mn": "Тодорхойлолт"}
  color       String?
  metadata    Json      @default("{}")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Content associations
  content ContentTag[]

  // News relations
  newsArticles NewsArticleTag[]

  @@unique([slug, tenantId])
  @@map("tags")
}

// Junction table for content-tag relationships
model ContentTag {
  id        String @id @default(cuid())
  contentId String
  tagId     String

  content Content @relation(fields: [contentId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contentId, tagId])
  @@map("content_tags")
}

// ================================
// AUDIT & LOGGING
// ================================

model AuditLog {
  id        String      @id @default(cuid())
  entity    String
  entityId  String
  action    AuditAction
  changes   Json        @default("{}")
  metadata  Json        @default("{}")
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // User who performed the action
  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  VIEW
  LOGIN
  LOGOUT
  BULK_UPDATE
  BULK_DELETE
}

// ================================
// SETTINGS & CONFIGURATION
// ================================

model Setting {
  id          String      @id @default(cuid())
  key         String
  value       Json
  type        SettingType @default(JSON)
  description String?
  isPublic    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([key, tenantId])
  @@map("settings")
}

enum SettingType {
  STRING
  NUMBER
  BOOLEAN
  JSON
  ARRAY
}

// ================================
// API TOKENS & WEBHOOKS
// ================================

model ApiToken {
  id          String    @id @default(cuid())
  name        String
  token       String    @unique
  permissions Json      @default("[]")
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Created by user
  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@map("api_tokens")
}

model Webhook {
  id          String   @id @default(cuid())
  name        String
  url         String
  events      Json     @default("[]")
  secret      String?
  isActive    Boolean  @default(true)
  retryPolicy Json     @default("{}")
  metadata    Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Multi-tenant relations
  tenantId String
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Webhook deliveries
  deliveries WebhookDelivery[]

  @@map("webhooks")
}

model WebhookDelivery {
  id           String                @id @default(cuid())
  webhookId    String
  event        String
  payload      Json
  status       WebhookDeliveryStatus @default(PENDING)
  responseCode Int?
  responseBody String?
  error        String?
  deliveredAt  DateTime?
  createdAt    DateTime              @default(now())

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@map("webhook_deliveries")
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// ================================
// ENHANCED NEWS CMS MODELS
// ================================

// News Categories for organizing articles
model NewsCategory {
  id          String         @id @default(cuid())
  name        Json // {"en": "Politics", "mn": "Улс төр"}
  slug        String
  description Json? // {"en": "Description", "mn": "Тайлбар"}
  color       String? // Hex color for UI
  icon        String? // Icon name
  parentId    String?
  parent      NewsCategory?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    NewsCategory[] @relation("CategoryHierarchy")

  // Relations
  articles  NewsArticle[]
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  deletedAt DateTime?

  @@unique([slug, tenantId])
  @@map("news_categories")
}

// Enhanced News Article Model with Block-Based Content
model NewsArticle {
  id String @id @default(cuid())

  // Basic Information
  title   Json // {"en": "Title", "mn": "Гарчиг"}
  slug    String
  excerpt Json? // {"en": "Excerpt", "mn": "Товчлол"}

  // News-Specific Fields
  subtitle Json? // {"en": "Subtitle", "mn": "Дэд гарчиг"}
  byline   Json? // {"en": "Author byline", "mn": "Зохиогчийн мэдээлэл"}

  // Content Structure (Block-Based)
  blocks Json // Array of content blocks in both languages

  // Media
  featuredImageId String?
  featuredImage   Media?  @relation("NewsFeaturedImage", fields: [featuredImageId], references: [id])

  // Categorization
  categoryId String?
  category   NewsCategory?    @relation(fields: [categoryId], references: [id])
  tags       NewsArticleTag[]

  // News Metadata
  location   Json? // {"en": "Location", "mn": "Байршил"}
  source     String? // News source if external
  priority   NewsPriority @default(NORMAL)
  isBreaking Boolean      @default(false)
  isFeatured Boolean      @default(false)

  // SEO & Social
  metaTitle       Json? // {"en": "SEO Title", "mn": "SEO Гарчиг"}
  metaDescription Json? // {"en": "SEO Description", "mn": "SEO Тайлбар"}
  socialImage     String? // Open Graph image
  keywords        Json? // {"en": ["keyword1"], "mn": ["түлхүүр_үг1"]}

  // Publishing
  status      ContentStatus @default(DRAFT)
  publishedAt DateTime?
  scheduledAt DateTime?

  // Multi-tenant & Timestamps
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("NewsArticleCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("NewsArticleUpdater", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([slug, tenantId])
  @@index([tenantId, status, publishedAt])
  @@index([tenantId, isBreaking])
  @@index([tenantId, isFeatured])
  @@index([categoryId])
  @@map("news_articles")
}

// Junction table for article tags
model NewsArticleTag {
  id        String @id @default(cuid())
  articleId String
  tagId     String

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     Tag         @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([articleId, tagId])
  @@map("news_article_tags")
}

// News Priority Enum
enum NewsPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  BREAKING
}

// ================================
// MERCHANDISE MANAGEMENT SYSTEM
// ================================

// Merchandise Categories
model MerchCategory {
  id          String  @id @default(cuid())
  name        Json // {"en": "T-Shirts", "mn": "Цамц"}
  slug        String
  description Json? // {"en": "Description", "mn": "Тайлбар"}
  color       String? // Hex color for UI
  icon        String? // Icon name

  // Hierarchy support
  parentId String?
  parent   MerchCategory?  @relation("MerchCategoryHierarchy", fields: [parentId], references: [id])
  children MerchCategory[] @relation("MerchCategoryHierarchy")

  // Relations
  products  MerchProduct[]
  tenantId  String
  tenant    Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  deletedAt DateTime?

  @@unique([slug, tenantId])
  @@map("merch_categories")
}

// Merchandise Products
model MerchProduct {
  id String @id @default(cuid())

  // Basic Information
  name             Json // {"en": "Product Name", "mn": "Бүтээгдэхүүний нэр"}
  slug             String
  description      Json? // {"en": "Description", "mn": "Тодорхойлолт"}
  shortDescription Json? // {"en": "Short desc", "mn": "Товч тодорхойлолт"}

  // Product Details
  sku     String? // Stock Keeping Unit
  barcode String? // Product barcode

  // Pricing
  price          Float // Base price
  compareAtPrice Float? // Original price (for sales)
  costPrice      Float? // Cost price (for profit calculation)
  currency       String @default("USD")

  // Inventory
  inventory      Int     @default(0)
  trackInventory Boolean @default(true)
  allowBackorder Boolean @default(false)
  minStock       Int? // Minimum stock level
  maxStock       Int? // Maximum stock level

  // Physical Properties
  weight     Float? // Product weight
  dimensions Json? // {"length": 10, "width": 5, "height": 2, "unit": "cm"}

  // Product Images
  featuredImage String? // Primary product image URL
  images        Json? // Array of image URLs

  // Categorization
  categoryId String?
  category   MerchCategory? @relation(fields: [categoryId], references: [id])
  tags       Json? // Array of tags

  // Product Options & Variants (Multi-language support)
  // Options stored as JSON with multi-language:
  // [
  //   { "name": {"en": "Color", "mn": "Өнгө"}, "values": [{"en": "Blue", "mn": "Цэнхэр"}, {"en": "Red", "mn": "Улаан"}] },
  //   { "name": {"en": "Size", "mn": "Хэмжээ"}, "values": [{"en": "Small", "mn": "Жижиг"}, {"en": "Large", "mn": "Том"}] }
  // ]
  hasVariants Boolean @default(false)
  variants    Json? // DEPRECATED: Legacy JSON storage, use productVariants relation instead
  options     Json? // Array of option types with multi-language names and values

  // Variant relations (named productVariants to avoid conflict with JSON column)
  productVariants MerchVariant[] @relation("ProductVariants")

  // SEO & Marketing
  metaTitle       Json? // {"en": "SEO Title", "mn": "SEO Гарчиг"}
  metaDescription Json? // {"en": "SEO Description", "mn": "SEO Тайлбар"}
  searchKeywords  Json? // {"en": ["keyword1"], "mn": ["түлхүүр_үг1"]}

  // Product Status
  status     MerchProductStatus @default(DRAFT)
  isFeatured Boolean            @default(false)
  isDigital  Boolean            @default(false)

  // Publishing
  publishedAt DateTime?

  // Multi-tenant & Timestamps
  tenantId    String
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User      @relation("MerchProductCreator", fields: [createdById], references: [id])
  updatedById String?
  updatedBy   User?     @relation("MerchProductUpdater", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  @@unique([slug, tenantId])
  @@unique([sku, tenantId])
  @@index([tenantId, status, isFeatured])
  @@index([categoryId])
  @@map("merch_products")
}

// Merchandise Product Variants
model MerchVariant {
  id String @id @default(cuid())

  // Variant Identity
  sku     String // Unique SKU for this variant
  barcode String? // Variant-specific barcode

  // Variant Title (multi-language) - e.g., {"en": "Blue / Large", "mn": "Цэнхэр / Том"}
  title Json? // Auto-generated or custom variant title

  // Option Values with multi-language support
  // Stores which option values this variant has:
  // [
  //   {"option": {"en": "Color", "mn": "Өнгө"}, "value": {"en": "Blue", "mn": "Цэнхэр"}},
  //   {"option": {"en": "Size", "mn": "Хэмжээ"}, "value": {"en": "Large", "mn": "Том"}}
  // ]
  optionValues Json // Array of selected option values for this variant

  // Variant-Specific Pricing
  price          Float // Variant price (can differ from base product)
  compareAtPrice Float? // Original price for this variant
  costPrice      Float? // Cost price for this variant

  // Variant-Specific Inventory
  inventory Int @default(0)

  // Physical Properties
  weight     Float? // Variant-specific weight
  dimensions Json? // {"length": 10, "width": 5, "height": 2, "unit": "cm"}

  // Variant Image
  image String? // Variant-specific image URL

  // Position for ordering variants
  position Int @default(0)

  // Status
  isAvailable Boolean @default(true)

  // Relations
  productId String
  product   MerchProduct @relation("ProductVariants", fields: [productId], references: [id], onDelete: Cascade)

  // Timestamps
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@unique([sku, productId])
  @@map("merch_variants")
}

// Product Status Enum
enum MerchProductStatus {
  DRAFT
  ACTIVE
  INACTIVE
  OUT_OF_STOCK
  DISCONTINUED
}

// ================================
// RALLY FOR RANGERS
// ================================

model Rally {
  id              String      @id @default(cuid())
  title           Json        // {"en": "Mongolia 2026", "mn": "Монгол 2026"}
  slug            String
  description     Json        // {"en": "Description", "mn": "Тайлбар"}

  // Rally Details
  startDate       DateTime
  endDate         DateTime
  location        Json        // {"en": "Mongolia", "mn": "Монгол"}
  duration        Int         // in days
  status          RallyStatus @default(DRAFT)

  // Target Audience
  targetAudience  Json        // ["riders", "non-riders", "volunteers"]
  maxParticipants Int?
  currentParticipants Int      @default(0)

  // Content & Media
  heroImage       String?
  heroVideo       String?     // YouTube/Vimeo embed URL
  gallery         Json?       // Array of image URLs
  highlights      Json?       // Array of video URLs

  // Impact & Partnerships
  impactOverview  Json        // {"en": "Impact summary", "mn": "Нөлөөний дүгнэг"}
  conservationActivities Json  // Array of activities
  rangerPartnerships Json     // Array of partner info

  // Application Settings
  isRecruiting     Boolean  @default(true)
  isPlaceholder    Boolean  @default(false) // "To be announced" card: no dates/spots/apply
  applicationDeadline DateTime?

  // Financial (without Stripe)
  cost             Json?       // {"amount": 5000, "currency": "USD"}
  depositAmount    Json?

  // SEO & Metadata
  metaTitle        Json?
  metaDescription  Json?
  featuredImage    String?

  // Multi-tenant & Timestamps
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdById     String
  createdBy       User        @relation("RallyCreator", fields: [createdById], references: [id])
  updatedById     String?
  updatedBy       User?       @relation("RallyUpdater", fields: [updatedById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  // Relations
  applications    RallyApplication[]
  media           RallyMedia[]
  stories         Story[]
  rangers         Ranger[]
  participants    ParticipantRally[]

  @@unique([slug, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, isRecruiting, status])
  @@map("rallies")
}

enum RallyStatus {
  DRAFT
  UPCOMING
  ONGOING
  COMPLETED
  CANCELLED
}

model RallyApplication {
  id              String           @id @default(cuid())
  rallyId         String
  status          ApplicationStatus @default(PENDING)

  // Personal Information (from passport)
  firstName       String
  lastName        String
  email           String
  phone           String
  country         String
  city            String
  address         Json?           // Street address, city, state/province, postal code
  birthdate       DateTime?

  // Passport & Travel
  hasValidPassport Boolean        @default(false)

  // Participation Type
  isRider         Boolean         @default(true) // true = rider, false = supporter

  // Rider Information
  hasMotorcycleLicense Boolean?
  ridingExperience Json?         // Years, terrain, bikes ridden, trip length, mileage
  ridingVideoUrl  String?         // Video demonstrating riding experience

  // Medical & Emergency
  isMedicalProfessional Boolean? // Doctor or Wilderness First Responder/EMT
  medicalCertificationType String?
  medicalConditions Json?        // Medical conditions
  dietaryRestrictions Json?      // Food allergies or dietary needs

  // Emergency Contact
  emergencyContactFirstName String
  emergencyContactLastName  String
  emergencyContactPhone     String
  emergencyContactEmail     String
  emergencyContactRelationship String

  // Social Media
  socialMediaLinks Json?          // Links to social media profiles

  // Application Questions
  motivation       Json           // Why do you want to participate?
  travelExperience Json           // Describe international travel experience
  futureLocations  Json?          // Where would you like to see RFR go next?
  howHeard         String?        // How did you find out about the rally?

  // Selected Rallies
  selectedRallies  Json           // Array of rally IDs applicant is interested in

  // Custom Form Responses (for rally-specific questions)
  customResponses Json           @default("{}")

  // Documents
  documentUrls   Json?           // Array of file URLs (license, insurance, etc.)

  // Payment Status (without Stripe)
  depositPaid     Boolean         @default(false)
  depositAmount   Float?
  fullyPaid       Boolean         @default(false)
  totalAmount     Float?
  fundraisingStatus Json?         // Fundraising progress

  // Terms & Conditions
  agreedToTerms   Boolean         @default(false)
  agreedToLiability Boolean       @default(false)

  // Metadata
  ipAddress       String?
  userAgent       String?
  source          String?         // How did they hear about us?
  notes           Json?           @default("{}")

  // Admin Review
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     Json?

  // Multi-tenant & Timestamps
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rally           Rally       @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@unique([email, rallyId, tenantId])
  @@index([tenantId, status])
  @@index([rallyId, status])
  @@index([tenantId, rallyId])
  @@map("rally_applications")
}

enum ApplicationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  WAITLIST
  REJECTED
  CANCELLED
  CONFIRMED
}

model ParkPartnership {
  id              String      @id @default(cuid())

  // Park Information
  parkName        Json        // {"en": "Gobi Gurvansaikhan NP", "mn": "Говь Гурвансайхан"}
  country         String
  location        Json        // {"en": "Mongolia", "mn": "Монгол", "coordinates": {...}}

  // Partnership Details
  establishedDate  DateTime?
  partnershipType Json        // ["motorcycle_donation", "equipment_support", "training"]

  // Impact
  rangersCount    Int?
  areaSize        Json?       // {"hectares": 15000, "acres": 37065}
  keyChallenges   Json?       // Array of challenges

  // Contact
  contactPerson   String?
  contactEmail    String?
  contactPhone    String?

  // Media
  photos          Json?       // Array of photo URLs
  videos          Json?       // Array of video URLs

  // Related Rallies
  rallies         Json?       // Array of rally info

  // Status
  status          PartnershipStatus @default(ACTIVE)

  // Multi-tenant & Timestamps
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@map("park_partnerships")
}

enum PartnershipStatus {
  PROPOSED
  ACTIVE
  INACTIVE
  COMPLETED
}

model Story {
  id              String      @id @default(cuid())
  rallyId         String?

  // Story Information
  title           Json        // {"en": "Title", "mn": "Гарчиг"}
  slug            String
  excerpt         Json?
  content         Json        // Full content with blocks
  type            StoryType   @default(IMPACT)

  // Story Metadata
  author          Json?       // Ranger or Rider name
  role            String?     // "Ranger" or "Rider" or "Staff"

  // Media
  featuredImage   String?
  gallery         Json?       // Array of images
  videoUrl        String?     // YouTube/Vimeo URL

  // Impact Data
  beforeData      Json?       // {"motorcycles": 0, "rangers": 10}
  afterData       Json?       // {"motorcycles": 5, "rangers": 10}
  impactSummary   Json?

  // Relationships
  tags            Json?       // Array of tag references
  relatedRallies  Json?       // Array of rally IDs

  // SEO
  metaTitle       Json?
  metaDescription Json?

  // Publishing
  status          ContentStatus @default(DRAFT)
  publishedAt     DateTime?

  // Display
  featured        Boolean     @default(false)
  displayOrder    Int         @default(0)

  // Multi-tenant & Timestamps
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rally           Rally?      @relation(fields: [rallyId], references: [id])
  createdById     String
  createdBy       User        @relation("StoryCreator", fields: [createdById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@unique([slug, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, type, status])
  @@map("stories")
}

enum StoryType {
  IMPACT
  TESTIMONIAL
  RANGER_PROFILE
  RIDER_PROFILE
  FIELD_MOMENT
  BEFORE_AFTER
  UPDATE
  NEWS
}

model RallyMedia {
  id              String      @id @default(cuid())
  rallyId         String

  // Media Information
  type            MediaTypeR
  url             String
  thumbnailUrl    String?
  title           Json?       // {"en": "Title", "mn": "Гарчиг"}
  description     Json?

  // Metadata
  fileSize        Int?
  dimensions      Json?       // {"width": 1920, "height": 1080}
  duration        Int?        // For videos (seconds)

  // Source
  source          String?     // "upload", "youtube", "vimeo"
  sourceUrl       String?     // Original URL if embedded

  // Display Settings
  isFeatured      Boolean     @default(false)
  displayOrder    Int         @default(0)

  // Multi-tenant & Timestamps
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  rally           Rally       @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  uploadedById    String
  uploadedBy      User        @relation("RallyMediaUploader", fields: [uploadedById], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@map("rally_media")
}

enum MediaTypeR {
  IMAGE
  VIDEO
  DOCUMENT
  THUMBNAIL
}

model NewsletterSubscription {
  id              String      @id @default(cuid())

  email           String
  firstName       String?
  lastName        String?

  // Preferences
  interests       Json?       // ["upcoming_rallies", "impact_stories", "events"]

  // Source Tracking
  source          String?     // "homepage", "rally_page", "application"

  // Status
  status          SubscriptionStatus @default(ACTIVE)

  // Email Marketing (for future integration)
  mailchimpId     String?
  sendGridId      String?

  // Statistics
  openCount       Int         @default(0)
  clickCount      Int         @default(0)

  // Multi-tenant & Timestamps
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?
  unsubscribedAt  DateTime?

  @@unique([email, tenantId])
  @@index([tenantId, status])
  @@map("newsletter_subscriptions")
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  PENDING
}

// ============================================
// PARK NOMINATION FORM
// ============================================

model ParkNomination {
  id              String      @id @default(cuid())

  // Park Information
  country         String
  parkNames       Json        // Array of park names
  parkWebsites    Json?       // Array of park websites

  // Primary Contact of the Park
  parkContactFirstName  String
  parkContactLastName   String
  parkContactEmail      String

  // Partner Organization Information
  partnerOrganizationName    String
  partnerContactFirstName    String
  partnerContactLastName     String
  partnerContactEmail        String
  partnerWebsite             String?
  partnerAddress             Json?       // Street address, city, state/province, postal code

  // Mission & Support
  primaryMission            Json        // Primary mission of the park
  motorcycleSupport         Json        // 3 ways motorcycles will help
  partnerLogisticsSupport   Json?       // How partner org can support logistics

  // Additional Information
  otherInfo        Json?
  howHeard         String?     // How did you hear about Rally for Rangers?

  // Metadata
  ipAddress        String?
  userAgent        String?
  source           String?

  // Status
  status          NominationStatus @default(PENDING)
  reviewedAt      DateTime?
  reviewedBy      String?
  reviewNotes     Json?

  // Multi-tenant & Timestamps
  tenantId        String
  tenant          Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  deletedAt       DateTime?

  @@index([tenantId, status])
  @@map("park_nominations")
}

enum NominationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SELECTED
  NOT_SELECTED
}

model TeamMember {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  role         String
  bio          String?
  photo        String?
  email        String?
  linkedinUrl  String?
  twitterUrl   String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  @@index([tenantId])
  @@index([tenantId, displayOrder])
  @@map("team_members")
}

enum ContactMessageStatus {
  NEW
  READ
  REPLIED
}

model ContactMessage {
  id        String               @id @default(cuid())
  tenantId  String
  tenant    Tenant               @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String
  email     String
  subject   String
  message   String               @db.Text
  status    ContactMessageStatus @default(NEW)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  @@index([tenantId])
  @@index([tenantId, status])
  @@map("contact_messages")
}

// ============================================
// RANGERS & PARTICIPANTS
// ============================================

model Ranger {
  id            String   @id @default(cuid())
  name          String
  photo         String?
  parkName      String
  country       String
  bio           String?  @db.Text
  displayOrder  Int      @default(0)
  isActive      Boolean  @default(true)

  // Optional link to a rally they were supported by
  rallyId       String?
  rally         Rally?   @relation(fields: [rallyId], references: [id])

  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, isActive])
  @@index([tenantId, displayOrder])
  @@map("rangers")
}

model Participant {
  id            String             @id @default(cuid())
  firstName     String
  lastName      String
  slug          String
  honoraryTitle String?
  photo         String?
  country       String
  bio           String?            @db.Text
  isActive      Boolean            @default(true)
  displayOrder  Int                @default(0)

  rallies       ParticipantRally[]

  tenantId      String
  tenant        Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?

  @@index([tenantId, isActive])
  @@unique([slug, tenantId], map: "participants_slug_tenant_idx")
  @@map("participants")
}

model ParticipantRally {
  id            String      @id @default(cuid())
  participantId String
  rallyId       String
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  rally         Rally       @relation(fields: [rallyId], references: [id], onDelete: Cascade)
  year          Int?
  role          String?

  @@unique([participantId, rallyId])
  @@map("participant_rallies")
}
