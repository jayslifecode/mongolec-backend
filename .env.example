# Application Environment
NODE_ENV=development
PORT=4000
HOST=localhost

# Database Configuration
# Development: local PostgreSQL
# DATABASE_URL="postgresql://postgres:password@localhost:5432/mongolec_db?schema=public"

# Production: Neon PostgreSQL (cloud database)
DATABASE_URL="postgresql://user:password@your-project.region.aws.neon.tech/neondb?sslmode=require"
DATABASE_POOL_SIZE=10
DATABASE_CONNECTION_TIMEOUT=5000

# Redis Configuration (Optional - for caching and session storage)
# Development: local Redis
# REDIS_URL="redis://localhost:6379"

# Production: Upstash Redis (cloud Redis) - optional, can skip for initial deployment
REDIS_URL="redis://your-redis.upstash.io:6379"
REDIS_PASSWORD=""
REDIS_DB=0

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_EXPIRES_IN="30d"

# Encryption
ENCRYPTION_KEY="your-32-character-encryption-key-12"

# Cors Configuration
# Development: localhost frontend
# CORS_ORIGIN="http://localhost:3000,http://localhost:3001"

# Production: your deployed frontend URLs
# For Rally for Rangers, CORS_ORIGIN must include the Vercel preview/prod domain
# (e.g. https://rally-for-rangers-website.vercel.app) and https://rallyforrangers.org
CORS_ORIGIN="https://your-admin.vercel.app,https://your-website.com,http://103.50.205.43:8080"
CORS_CREDENTIALS=true

# Cookie domain — set to ".yourdomain.com" in production so the auth cookie is readable
# by all subdomains (e.g. admin.yourdomain.com Next.js middleware can verify it).
# Leave empty for local development.
COOKIE_DOMAIN=

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=debug
LOG_FILE_ENABLED=true
LOG_FILE_PATH="./logs"

# Multi-tenant Configuration
DEFAULT_TENANT_SLUG="default"
TENANT_ISOLATION_LEVEL="strict"

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH="./uploads"

# Backblaze B2 Storage (required for file uploads)
# B2_ENDPOINT must include the scheme (https://) or the S3 SDK throws "Invalid URL".
B2_ENDPOINT="https://s3.<region>.backblazeb2.com"
B2_REGION="us-west-004"
B2_ACCESS_KEY_ID="your-key-id"
B2_SECRET_ACCESS_KEY="your-application-key"
B2_BUCKET_NAME="your-bucket-name"
# Public base URL used to build stored file URLs. If omitted, it is derived as
# https://<B2_BUCKET_NAME>.<B2_ENDPOINT-host>. Must match the frontends' next.config remotePatterns.
B2_PUBLIC_URL="https://your-bucket-name.s3.<region>.backblazeb2.com"

# Email Configuration (for notifications)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""

# Resend (transactional email for Rally for Rangers public forms)
# Leave unset in local dev — sendEmail() logs and no-ops without it.
RESEND_API_KEY=""
# Sender address used for all outgoing emails.
EMAIL_FROM="Rally for Rangers <noreply@rallyforrangers.org>"
# Internal address that receives admin notifications for applications,
# nominations, and contact messages.
ADMIN_NOTIFY_EMAIL="info@rally4rangers.org"

# Monitoring
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# GraphQL endpoint rate limit per client IP (default 2000 per 15 min)
GRAPHQL_RATE_LIMIT_MAX=2000
GRAPHQL_RATE_LIMIT_WINDOW_MS=900000

# Bearer token required to read /metrics (endpoint returns 401 when unset)
METRICS_SECRET=

# QPay V2 payments (sandbox by default; flip base url + creds for production)
QPAY_BASE_URL=https://merchant-sandbox.qpay.mn
QPAY_CLIENT_ID=
QPAY_CLIENT_SECRET=
QPAY_INVOICE_CODE=MONGOLEC_ORG_INVOICE
QPAY_CALLBACK_BASE_URL=
QPAY_CALLBACK_SECRET=
QPAY_INVOICE_TTL_MINUTES=30
